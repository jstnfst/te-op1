# Lab tools are static pages; serve them under the /lab path. Extensionless
# targets because Pages pretty-URLs redirects *.html to the bare path.
/lab/layout         /params      200
/lab/mappings       /display     200
/lab/inspector      /patch       200
# The same page is the Library's patch editor (patch.html picks its mode
# from the path).
/library/editor     /patch       200
# params.html links to its sibling relatively ("display.html"), which resolves
# under /lab/ when served at /lab/layout.
/lab/display.html   /lab/mappings  301
/lab/params.html    /lab/layout    301
/lab/patch.html     /lab/inspector 301


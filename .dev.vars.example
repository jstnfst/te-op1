# Copy to .dev.vars (gitignored) for local dev. Production secrets are set with
# `wrangler pages secret put <NAME>`.

SITE_URL=http://localhost:8788
JWT_SECRET=dev-only-change-me

# Mock login personas at /api/auth/dev and on /login. Local only: it also
# requires a localhost SITE_URL and a localhost request, and must never be set
# in production (wrangler.toml [vars] or Pages secrets).
DEV_LOGIN=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
